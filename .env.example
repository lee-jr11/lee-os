# Generate real local values with npm run db:configure; never commit .env.
POSTGRES_USER=leeos
POSTGRES_DB=leeos
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
DATABASE_URL=postgresql://leeos:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/leeos
# Optional separate test database for npm run test:postgres. Never use production here.
# LEEOS_TEST_DATABASE_URL=postgresql://leeos:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/leeos_test

# Run npm run api:configure to append real matching values to ignored local files.
# LEEOS_API_TOKEN=64_CHARACTER_RANDOM_HEX_OWNER_TOKEN
# LEEOS_API_ORIGIN=http://127.0.0.1:3000

# Structure 5 uses metadata only. No model API keys or provider SDK setup is required.
# Do not put owner or future provider credentials in NEXT_PUBLIC_* variables.

# Structure 8: explicit opt-in for a dedicated, local-only llama.cpp server on 127.0.0.1:18081.
# Read docs/structure-8.md before enabling. No cloud credentials or automatic downloads.
# LEEOS_LOCAL_PROVIDER_ENABLED=1
# LEEOS_LOCAL_PROVIDER_LOCAL_ONLY=1

# Structure 9: owner-authorized local model jobs only; also requires both local-provider flags.
LEEOS_JOB_EXECUTION_ENABLED=0

# Structure 10: allow explicit local coordination polls; queues runs for owner review only.
LEEOS_COORDINATION_ENABLED=0

# P0.4 standalone worker: separately started, never launched by the Hub/API.
# Also enable both local-provider flags above for local text generation.
LEEOS_ENVELOPE_WORKER_ENABLED=0

# P0.5 Gemini free-tier route: opt in only with a dedicated Google project
# whose billing is disabled. Both credentials stay server-side; never use NEXT_PUBLIC_*.
# LEEOS_GEMINI_PROVIDER_ENABLED=0
# GEMINI_API_KEY=REPLACE_WITH_RESTRICTED_GEMINI_API_KEY
# GOOGLE_CLOUD_SERVICE_ACCOUNT_JSON=REPLACE_WITH_READ_ONLY_SERVICE_ACCOUNT_JSON

# P0.5 GitHub Actions needs the leeos-remote-worker environment secret
# LEEOS_REMOTE_DATABASE_URL plus the explicit environment variable
# LEEOS_REMOTE_WORKER_ENABLED=1. Credentials alone leave it idle. Do not expose a workstation DB.

# P1.1 PostgreSQL-backed artifact storage is opt-in. Enable only after confirming
# the configured database has adequate included storage and no automatic overage billing.
# LEEOS_ARTIFACT_STORAGE_ENABLED=0

# P1.2 uses a local Python specialist with the pinned dependency in requirements-python.txt.
# The executable defaults to python; set this only when the runtime is elsewhere.
# LEEOS_PYTHON_EXECUTABLE=python
# For workers launched outside the monorepo root, optionally set the absolute Python DOCX script directory.
# LEEOS_PYTHON_DOCX_DIRECTORY=REPLACE_WITH_ABSOLUTE_PATH_TO_PACKAGES_EXECUTORS_SRC_PYTHON_DOCX

# P1.3 generic email delivery is disabled by default. Resend sends only after
# sender-domain inspection and a fresh owner attestation that the account is
# on its $0 plan with paid overages disabled. The attestation expires after 24h.
LEEOS_RESEND_EMAIL_ENABLED=0
LEEOS_RESEND_FREE_PLAN_CONFIRMED=0
LEEOS_RESEND_PAYG_DISABLED=0
LEEOS_RESEND_ZERO_COST_CONFIRMED_AT=REPLACE_WITH_RECENT_ISO_8601_UTC_TIMESTAMP
RESEND_API_KEY=REPLACE_WITH_SERVER_SIDE_RESEND_API_KEY
RESEND_FROM_EMAIL=Lee <noreply@example.com>
# The API host needs the webhook secret; the remote sending worker does not.
RESEND_WEBHOOK_SECRET=REPLACE_WITH_SERVER_SIDE_RESEND_WEBHOOK_SECRET
# Never use NEXT_PUBLIC_* for email credentials. The signed receipt endpoint
# is /api/v1/webhooks/resend and requires a reachable HTTPS LeeOS API.
