# db:configure generates .env.local for local PostgreSQL. No secrets in NEXT_PUBLIC_*.
# Leave DATABASE_URL unset to keep the Hub running with database readiness unavailable.
# DATABASE_URL=postgresql://leeos:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/leeos
NEXT_TELEMETRY_DISABLED=1

# Run npm run api:configure to append real matching values to ignored local files.
# LEEOS_API_TOKEN=64_CHARACTER_RANDOM_HEX_OWNER_TOKEN
# LEEOS_API_ORIGIN=http://127.0.0.1:3000

# Structure 5 uses metadata only. No model API keys or provider SDK setup is required.
# Do not put owner or future provider credentials in NEXT_PUBLIC_* variables.

# Structure 8: explicit opt-in for a dedicated, local-only llama.cpp server on 127.0.0.1:18081.
# Read docs/structure-8.md before enabling. No cloud credentials or automatic downloads.
# LEEOS_LOCAL_PROVIDER_ENABLED=1
# LEEOS_LOCAL_PROVIDER_LOCAL_ONLY=1

# Structure 9: owner-authorized local model jobs only; also requires both local-provider flags.
LEEOS_JOB_EXECUTION_ENABLED=0

# Structure 10: allow explicit local coordination polls; queues runs for owner review only.
LEEOS_COORDINATION_ENABLED=0
